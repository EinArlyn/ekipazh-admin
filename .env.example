# База данных
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432

# Почта
MAILER_USER=
MAILER_PASSWORD=
MAILER_HOST=
MAILER_SSL=false
MAIL_FROM=

# Ссылки приложения
SPEC_LINK=
CALCULATOR_LINK=
ORDER_EXPORT_LINK=
EXPORT_ORDER_HZ_LINK=
ANALYTICS_URL=
ACTIVATION_URL=
PRO_URL=
DOCUMENTS_URL=
STATISTIC_LINK=

# Homefash IDS API
HOMEFASH_API_URL=https://homefash-ids-api.shw-komplett.de
# токен уходит в заголовке Api-Key
HOMEFASH_API_KEY=
HOMEFASH_API_KEY_HEADER=Api-Key
HOMEFASH_TIMEOUT=30000
# true — payload только собирается и пишется в лог, запрос не уходит
HOMEFASH_DRY_RUN=true
HOMEFASH_SUPPLIER_ID=
HOMEFASH_SUPPLIER_NAME=Ekipazh
# поле users, в котором лежит номер клиента на стороне Homefash
HOMEFASH_CUSTOMER_ID_FIELD=code_kb
# временный номер клиента для тестов, пока поле в БД не заполнено
HOMEFASH_FALLBACK_CUSTOMER_ID=
# логины (users.phone), которым доступна кнопка отправки, через запятую
HOMEFASH_ALLOWED_LOGINS=dl_de7
# страна берётся из города пользователя, это значение — запасное
HOMEFASH_DEFAULT_COUNTRY=Deutschland
# делить ли цены на orders.currency_value (цены заказа в валюте расчёта)
HOMEFASH_CONVERT_CURRENCY=true
# процент НДС, вычитаемый из offerPrice (19/119); партнёр начисляет налог сам, 0 — не вычитать
HOMEFASH_OFFER_VAT_RATE=15.9664
# префикс номера предложения, например "[TEST] "
HOMEFASH_OFFER_PREFIX=

# Сервер
PORT=3000
SESSION_SECRET=
NODE_ENV=production
