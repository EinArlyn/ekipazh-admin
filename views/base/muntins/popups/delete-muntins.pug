.pop-up.pop-up-muntins#popup-delete-muntins
  form#delete-muntins-form(method="POST" action="/base/muntins/muntins/delete" enctype="multipart/form-data")
    input(type="hidden" name="system_id" value='' required)
    .pop-up-close-wrap
      a(class="pop-up-close", href="#")
    span.pop-up-header
      =i18n.__("Remove")
    .row.block-center.text-center
      input.btn-submit(type="submit" value=i18n.__('Remove'))
