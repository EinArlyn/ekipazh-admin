.pop-up-default.alert-homefash
  .pop-up-close-wrap
    a(class="pop-up-close", href="#")
  span.pop-up-header
    =i18n.__('Confirm action')
  .row
    .col-md-12.text-center#homefash-action-type
      =i18n.__('Send order to Homefash?')
  .row
    .col-md-6.text-center
      input.pop-up-submit-btn#send-homefash-btn(type="button" value=i18n.__('Yes'))
    .col-md-6.text-center
      input.pop-up-deny-btn(type="button" value=i18n.__('No'))
